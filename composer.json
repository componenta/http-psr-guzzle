{
    "name": "componenta/http-psr-guzzle",
    "description": "Guzzle PSR-7 and PSR-17 integration for Componenta HTTP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0.0 || ^4.0.0",
        "guzzlehttp/psr7": "^2.8",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Psr7\\Guzzle\\": "src/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Psr7\\Guzzle\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev",
            "dev-refactor/unified-application-build-2026-11-27": "1.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "componenta/di": "^5.0.0 || ^6.0.0",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests"
    }
}
